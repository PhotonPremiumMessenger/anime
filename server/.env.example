# ============================================================
# AniLingo — переменные окружения сервера
#
# Скопируйте файл в .env и заполните значения:
#     cp .env.example .env
#
# Файл .env в репозиторий не попадает (он в .gitignore).
# ============================================================

# ---------- Сервер ----------

# Порт, на котором слушает Express
PORT=3000

# 0.0.0.0 — принимать соединения снаружи (нужно на VPS)
HOST=0.0.0.0

# Раздавать ли сам сайт из корня репозитория.
# 1 (или строки нет) — да, Express отдаёт index.html, css, js, assets.
# 0 — нет, статику раздаёт nginx, а Express работает только как API.
SERVE_STATIC=1

# Откуда браузеру разрешено обращаться к API. Несколько адресов — через запятую.
# Для продакшена лучше указать точный адрес сайта, а не *.
# CORS_ORIGIN=https://photonpremiummessenger.github.io,https://anilingo.ru
CORS_ORIGIN=*

# ---------- База данных ----------

# Путь к файлу SQLite. По умолчанию server/data/anilingo.db
# DB_PATH=/var/lib/anilingo/anilingo.db

# ---------- Токены ----------

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО замените на свой:
#     openssl rand -hex 32
JWT_SECRET=замените-это-на-случайную-строку-из-32-байт

# Сколько живёт токен входа (30 дней, 7d, 12h)
JWT_TTL=30d

# ---------- Почта (коды подтверждения) ----------
#
# Google здесь — ТОЛЬКО почтовый сервис для отправки писем.
# Никакой авторизации через Google на сайте нет и не планируется:
# вход и регистрация остаются по нику и паролю.

# Адрес, с которого уходят письма (например, your.name@gmail.com)
EMAIL_USER=

# Пароль приложения Google, НЕ обычный пароль от аккаунта.
# Получить: myaccount.google.com → Безопасность → Двухэтапная
# аутентификация → Пароли приложений → создать.
EMAIL_PASS=

# Имя отправителя в письме
EMAIL_FROM=AniLingo

# SMTP-сервер. Для Gmail менять не нужно.
# Для Яндекс.Почты: smtp.yandex.ru / 465
# Для Mail.ru: smtp.mail.ru / 465
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# ---------- Заготовки под будущее ----------
#
# Пока НЕ используются: логики OAuth в проекте нет.
# Место для ключей, если когда-нибудь понадобится вход через Google.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
