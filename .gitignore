# Зависимости сервера
server/node_modules/

# Секреты: .env остаётся только на сервере
server/.env
.env

# Загруженные файлы оформления (фоны профиля, аватары) — это данные, не код
server/uploads/

# База данных SQLite и её служебные файлы
server/data/
*.db
*.db-wal
*.db-shm

# Логи и системный мусор
*.log
npm-debug.log*
.DS_Store
Thumbs.db
